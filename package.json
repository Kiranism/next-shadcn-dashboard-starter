    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "kbar": "^1.0.0",
    "match-sorter": "^8.3.0",
    "motion": "^14.2.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.2",
    "postcss": "8.5.30",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
