    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sort-by": "^1.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
